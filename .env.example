# Production build'de API'nin tam adresi (sonunda / olmadan). Boş bırakılırsa istekler
# aynı origin'e (/api/...) gider; bu durumda frontend ve API aynı alan adından sunulmalıdır.
VITE_API_BASE_URL=

# Sadece geliştirme: Vite dev sunucusunun /api isteklerini yönlendireceği backend adresi
VITE_DEV_API_PROXY_TARGET=http://localhost:8081

# Test sürecinde "Sorun bildir" düğmesinin açacağı e-posta adresi (boşsa düğme gizlenir)
VITE_FEEDBACK_EMAIL=
